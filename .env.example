DMM_API_ID=your_api_id
DMM_AFFILIATE_ID=your_affiliate_id
# Items per page (max 12). Infinite scroll loads additional pages.
FANZA_HITS=8

# Search UX (FANZA single provider):
# auto | unified | source_tabs — FANZAのみのため通常は unified か auto で十分です。
MULTI_SEARCH_MODE=auto
# Timeout for FANZA API calls (milliseconds)
PROVIDER_TIMEOUT_MS=3000
# In auto mode, optional slow-response fallback hint threshold (milliseconds)
MULTI_FALLBACK_SLOW_MS=2400

# Canonical site URL for metadata / sharing / WebAuthn RP ID (production)
# NEXT_PUBLIC_SITE_URL=https://fanza-nine.vercel.app

# Footer "feedback" link (defaults to GitHub new issue)
# NEXT_PUBLIC_FEEDBACK_URL=https://github.com/your/repo/issues/new

# Default is ON when Blob (or other durable store) is configured on the host.
# Local-only favorites when 0. Set to 1 for cross-browser sync via login.
NEXT_PUBLIC_ENABLE_ACCOUNT_SYNC=0

# Optional: directory for file-based auth + favorites sync (default: .data under project root).
# On Docker/VPS, set to an absolute path on a mounted volume, e.g. /data
# FANZA_APP_DATA_DIR=/data

# On Vercel, create a private Blob store and BLOB_READ_WRITE_TOKEN is injected automatically.
# userStore uses Blob when this token is present (serverless-safe persistence).
# BLOB_READ_WRITE_TOKEN=
